# docker-clash 统一入口
# envsubst 只会替换环境中存在的变量（${ZURL_SHORT_TOKEN}），$host 等 nginx 变量不受影响
map $http_x_forwarded_proto $gateway_proto {
    ~*^https(?:,|$) https;
    ~*^http(?:,|$)  http;
    default         $scheme;
}

server {
    listen 80;
    server_name _;

    # Docker 内置 DNS；对可由页面停止/启动的 mihomo 使用运行时解析，避免
    # mihomo 停止时 nginx 因启动阶段解析失败而拖垮整个 Web 入口。
    resolver 127.0.0.11 ipv6=off valid=10s;

    # 保持重定向为相对地址，让浏览器沿用外部访问的协议、域名和端口（如 :7788）。
    absolute_redirect off;

    # 订阅链接可能很长
    client_max_body_size 10m;

    # ---- 公网入口认证：zurl 校验 HttpOnly Cookie，未登录统一跳登录页 ----
    location = /_gateway_auth {
        internal;
        proxy_pass http://zurl:3080/gateway/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location = /login {
        proxy_pass http://zurl:3080/gateway/login-page;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
    }
    location = /gateway/login {
        limit_except POST { deny all; }
        proxy_pass http://zurl:3080/gateway/login;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
    }
    location = /logout {
        proxy_pass http://zurl:3080/gateway/logout;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
    }
    location = /gateway/form-config {
        auth_request /_gateway_auth;
        error_page 401 = @gateway_login_redirect;
        limit_except GET POST { deny all; }
        proxy_pass http://zurl:3080/gateway/form-config;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_read_timeout 30s;
    }
    location @gateway_login_redirect {
        return 302 /login;
    }

    # ---- 官方 metacubexd 面板 ----
    # 官方镜像按根路径构建；反代时去掉 /xd 前缀，并把 HTML 中的 Nuxt
    # 资源地址和运行时 baseURL 改为 /xd/，镜像本身无需重新编译。
    location = /xd {
        auth_request /_gateway_auth;
        error_page 401 = @gateway_login_redirect;
        return 301 /xd/;
    }
    location /xd/ {
        auth_request /_gateway_auth;
        error_page 401 = @gateway_login_redirect;
        proxy_pass http://metacubexd:80/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        sub_filter 'href="/_nuxt/' 'href="/xd/_nuxt/';
        sub_filter 'src="/_nuxt/' 'src="/xd/_nuxt/';
        sub_filter 'baseURL:"/"' 'baseURL:"/xd/"';
        proxy_read_timeout 60s;
    }

    # ---- mihomo Clash API（路径 /clash/，含 WebSocket 升级，面板连接用）----
    # 面板后端地址填写：http(s)://当前域名/clash
    location /clash/ {
        auth_request /_gateway_auth;
        error_page 401 = @gateway_login_redirect;
        set $mihomo_upstream mihomo:9090;
        rewrite ^/clash/(.*)$ /$1 break;
        proxy_pass http://$mihomo_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        # WebSocket 长连接，不要超时断开
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---- 生成 mihomo 最新候选配置（仅 POST，不重启，同 /short）----
    location = /apply {
        auth_request /_gateway_auth;
        error_page 401 = @gateway_login_redirect;
        limit_except POST { deny all; }
        proxy_pass http://zurl:3080/apply;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_set_header X-Short-Token "${ZURL_SHORT_TOKEN}";
        # 转换拉取远程规则可能耗时较长
        proxy_read_timeout 300s;
    }

    # ---- mihomo 状态查询（GET，供首页状态标签轮询）----
    location = /mihomo/status {
        auth_request /_gateway_auth;
        error_page 401 = @gateway_login_redirect;
        proxy_pass http://zurl:3080/mihomo/status;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_set_header X-Short-Token "${ZURL_SHORT_TOKEN}";
        proxy_read_timeout 30s;
    }

    # ---- 启停 mihomo（仅 POST，注入内部令牌，同 /short）----
    location /mihomo/ {
        auth_request /_gateway_auth;
        error_page 401 = @gateway_login_redirect;
        limit_except POST { deny all; }
        proxy_pass http://zurl:3080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_set_header X-Short-Token "${ZURL_SHORT_TOKEN}";
        proxy_read_timeout 60s;
    }

    # ---- zurl 短链生成 API（仅 POST，注入内部令牌，浏览器不可见）----
    location = /short {
        auth_request /_gateway_auth;
        error_page 401 = @gateway_login_redirect;
        limit_except POST { deny all; }
        proxy_pass http://zurl:3080/short;
        # 注意：location 内一旦定义 proxy_set_header，server 级的同名指令不再继承，需全部重写
        # $host 会丢掉 7788 这类非标准端口；短链必须保留用户实际访问的 host:port
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_set_header X-Short-Token "${ZURL_SHORT_TOKEN}";
        proxy_read_timeout 30s;
    }

    # ---- zurl 短链解析跳转：/s/xxxx → zurl /xxxx（302）----
    location /s/ {
        proxy_pass http://zurl:3080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_read_timeout 30s;
    }

    # ---- 版本探测：注入脚本探测头，使后端返回纯文本版本号而非 HTML 面板页 ----
    location = /subapi/version {
        proxy_pass http://subconverter:25500/version;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_set_header Sec-Fetch-Mode "cors";
        proxy_set_header Sec-Fetch-Dest "empty";
        proxy_read_timeout 30s;
    }

    # 所有 GET 订阅转换先经过地区名称兼容层；其余后端接口保持直连。
    location = /subapi/sub {
        proxy_pass http://zurl:3080/subapi-compat/sub;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
    }

    # ---- SubConverter-Extended 后端：/subapi/xxx → :25500/xxx ----
    location /subapi/ {
        proxy_pass http://subconverter:25500/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        # 拉取机场订阅可能很慢
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
    }

    # ---- GitHub 各 Clash 版本香港/日本提供商复写版订阅 ----
    # 与 /subapi/ 一样保持公开，代理客户端需要定时刷新；zurl 内部仍只允许
    # 页面内置的受信任 GitHub 配置，并在转换后增量扩展香港、日本组。
    location /provider-regions/ {
        proxy_pass http://zurl:3080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
    }

    # ---- sub-web-modify 前端（订阅转换界面）----
    location / {
        auth_request /_gateway_auth;
        error_page 401 = @gateway_login_redirect;
        proxy_pass http://sub-web:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
    }
}
