# ===== Web 入口（nginx）=====
# 订阅转换界面的对外端口，默认 7788
WEB_PORT=7788

# ===== zurl 短链 API 内部令牌 =====
# 浏览器不可见：nginx 反代 /short 时自动注入 X-Short-Token 头，zurl 侧校验。
# 请务必修改为一串随机字符串；留空则 /short 不校验（公网不推荐）。
ZURL_SHORT_TOKEN=please-change-me-to-a-long-random-string

# ===== metacubexd 面板 =====
# 面板经 nginx /xd/ 路径访问，无独立端口
# 预填到面板连接表单的后端地址，例如 http://192.168.1.10/clash 或 http://sub.example.com/clash
# 留空则打开面板后手动填写
DEFAULT_BACKEND_URL=
# 面板侧边栏「订阅转换」快捷入口地址，例如 http://192.168.1.10/ 或 http://sub.example.com/
# 留空则自动推导为 当前主机名 + 80 端口
SUB_WEB_URL=

# ===== mihomo 代理端口（默认已开启局域网访问）=====
# 局域网其他设备可直接把本机作为代理网关（IP:7890）；不需要时到 docker-compose.yml 注释掉端口映射
MIXED_PORT=7890
# 转换应用后自动写入的 mihomo 管理密钥（管理端口固定 9090，面板连接时使用）
MIHOMO_SECRET=yuan
