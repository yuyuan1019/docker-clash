# ===== Web 入口（nginx）=====
# 订阅转换界面的对外端口，默认 7788
WEB_PORT=7788
# 内网使用保持 false（无需登录）；开放公网时改为 true，登录密钥使用 MIHOMO_SECRET
WEB_AUTH_ENABLED=false
# 登录有效期（秒），默认 10 年；修改 MIHOMO_SECRET 会立即使旧登录失效
WEB_AUTH_TTL=315360000

# ===== zurl 短链 API 内部令牌 =====
# 浏览器不可见：nginx 反代 /short 时自动注入 X-Short-Token 头，zurl 侧校验。
# 请务必修改为一串随机字符串；留空则 /short 不校验（公网不推荐）。
ZURL_SHORT_TOKEN=please-change-me-to-a-long-random-string

# ===== metacubexd 面板 =====
# 使用官方 ghcr.io/metacubex/metacubexd 镜像，经 nginx /xd/ 路径访问，无独立端口
# 可预填完整后端地址，例如 https://example.com/clash；留空时在面板中手动填写
DEFAULT_BACKEND_URL=

# ===== mihomo 代理端口（默认已开启局域网访问）=====
# 局域网其他设备可直接把本机作为代理网关（IP:7890）；不需要时到 docker-compose.yml 注释掉端口映射
MIXED_PORT=7890
# mihomo 管理密钥，同时作为公网首页登录密钥；务必设置为足够长的随机字符串
MIHOMO_SECRET=yuan
