# 本地运行数据（订阅地址、数据库、缓存及转换配置均不提交；参考 config/ 下的示例）
data/

# 本地环境变量与备份（含内部令牌，参考 .env.example）
.env
.env.*
!.env.example

# mihomo 本地配置、生成文件及备份（可能含密钥/订阅地址），只允许脱敏示例
config/mihomo/*
!config/mihomo/config.example.yaml

# metacubexd 面板镜像包与解压产物（运行时产物）
metacubexd-image.tar.gz
metacubexd/

# 依赖与构建产物
node_modules/
dist/
.output/
.nuxt/
.nitro/
**/__pycache__/
*.pyc

# 系统文件
.DS_Store
Thumbs.db
